# VideoShortsAgent 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ── LLM 配置（默认 DeepSeek）──
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# OpenAI 兼容 API 根地址（一般无需改）
LLM_BASE_URL=https://api.deepseek.com/v1

# 主模型：deepseek-chat（对话/分镜）| deepseek-reasoner（推理更强、更慢）
LLM_MODEL=deepseek-chat

# 分析 / 翻译（默认同 LLM_MODEL）
# LLM_ANALYSIS_MODEL=deepseek-chat
# LLM_TRANSLATE_MODEL=deepseek-chat

# ── 转录配置 ──
# Groq API Key（推荐，极速语音转录）
# 获取地址: https://console.groq.com/
GROQ_API_KEY=gsk_你的API密钥

# 转录模式: groq（推荐） / local（本地 faster-whisper）
# TRANSCRIBE_MODE=groq

# ── TTS 配置 ──
# 渠道: auto（Edge 优先，失败走 Key）| edge | dashscope | azure | openai
# TTS_PROVIDER=auto
# TTS_FALLBACK=dashscope,azure,openai
# TTS_VOICE=zh-CN-YunxiNeural
# TTS_MAX_RETRIES=6
# TTS_MAX_CONCURRENT=1

# 阿里云百炼 / Dashscope（推荐 Key 备用，与 LLM 可共用）
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash
# DASHSCOPE_TTS_VOICE=Cherry
# DASHSCOPE_TTS_LANGUAGE=Chinese

# Azure 语音服务
# AZURE_SPEECH_KEY=xxx
# AZURE_SPEECH_REGION=eastasia
# AZURE_TTS_VOICE=zh-CN-YunxiNeural

# OpenAI 兼容 TTS（中文效果一般，作最后备用）
# OPENAI_TTS_API_KEY=sk-xxx
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova

# ── Agent 配置 ──
# MAX_ITERATIONS=10
# MAX_VIDEO_DURATION=65

# ── 服务器配置 ──
# SERVER_PORT=7860

# ── 外部 API（可选）──
# FREESOUND_API_KEY=
# PEXELS_API_KEY=
