# VideoShortsAgent 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ── LLM 配置（默认 DeepSeek）──
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# OpenAI 兼容 API 根地址（一般无需改）
LLM_BASE_URL=https://api.deepseek.com/v1

# 主模型：deepseek-chat（对话/分镜）| deepseek-reasoner（推理更强、更慢）
LLM_MODEL=deepseek-chat

# 分析 / 翻译（默认同 LLM_MODEL）
# LLM_ANALYSIS_MODEL=deepseek-chat
# LLM_TRANSLATE_MODEL=deepseek-chat

# ── 转录配置 ──
# Groq API Key（推荐，极速语音转录）
# 获取地址: https://console.groq.com/
GROQ_API_KEY=gsk_你的API密钥

# 转录模式: groq（推荐） / local（本地 faster-whisper）
# TRANSCRIBE_MODE=groq

# ── TTS 配置 ──
# 默认语音角色（Edge TTS，无需 Key）
# TTS_VOICE=zh-CN-YunxiNeural

# ── Agent 配置 ──
# MAX_ITERATIONS=10
# MAX_VIDEO_DURATION=65

# ── 服务器配置 ──
# SERVER_PORT=7860

# ── 外部 API（可选）──
# FREESOUND_API_KEY=
# PEXELS_API_KEY=
